#!name=Bilibili Mac Chrome 网页净化模块
#!desc=专为 Mac 浏览器优化，将原 BiliHD 移动端逻辑重构为网页端 Web API 净化，强行降级 QUIC 协议。
#!system=mac

[Rule]
# 1. 强制降级 Chrome 的网络协议
AND,((CONN-TRACKER,client:chrome), (DEST-PORT,443)),REJECT-DROP

# 2. 针对 Web 网页端的网络层牛皮癣广告与追踪断流
URL-REGEX,^https?:\/\/api\.bilibili\.com\/x\/report\/,REJECT
URL-REGEX,^https?:\/\/cm\.bilibili\.com\/,REJECT

[Script]
# 3. 拦截并使用 GitHub 上的远程魔改 JS 脚本清洗 Web API 数据
Bili_Mac_Web = type=http-response,pattern=^https?:\/\/api\.bilibili\.com\/x\/web-interface\/(wbi\/index\/top\/feed\/rcmd|wbi\/archive\/related|wbi\/operation\/activity),requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/anyi11/anyi11/refs/heads/master/Bili_Mac_Web.js

[MITM]
# 4. 扩充解密域名清单
hostname = %APPEND% api.bilibili.com, cm.bilibili.com
