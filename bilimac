#!name=Bilibili Mac Web Ads Cleaner
#!desc=专为 Mac 浏览器重构的 B站网页去广告模块。完全剥离移动端 iOS 脚本与 YouTube 规则，仅通过网络层断流（Reject）干净拦截 B站网页端牛皮癣与广告。
#!system=mac

[Rule]
# ==================== [1. Mac 浏览器核心降级铁律] ====================
# 必须放在 Rule 的第一行！拦截 UDP 443 端口，强行将 Chrome 降级到可以被 Surge 解密的 HTTP/2 协议
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-DROP

# ==================== [2. Bilibili 网页端广告断流] ====================
DOMAIN-SUFFIX,cm.bilibili.com,REJECT
DOMAIN-SUFFIX,ad.bilibili.com,REJECT
URL-REGEX,^https?:\/\/api\.bilibili\.com\/x\/web-show\/ads,REJECT
URL-REGEX,^https?:\/\/api\.bilibili\.com\/x\/front\/ad,REJECT

[MITM]
# ==================== [3. Mac 网页端专属解密域名] ====================
hostname = %APPEND% www.bilibili.com, bilibili.com, *.bilibili.com
